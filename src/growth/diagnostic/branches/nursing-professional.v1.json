{
  "version": "nursing-professional.branch.v1",
  "branch": "nursing-professional",
  "title": "Nursing Professional",
  "family_label": "Already a nurse",
  "questions": [
    {
      "id": "qualification",
      "prompt": "What nursing qualification do you hold?",
      "affects": ["pathway", "band", "gaps", "risk_notes"],
      "options": [
        { "value": "bsc_nursing", "label": "BSc Nursing" },
        { "value": "msc_nursing", "label": "MSc / Post-BSc Nursing" },
        { "value": "gnm", "label": "GNM diploma" },
        { "value": "ani", "label": "ANM" },
        { "value": "other_health", "label": "Other health qualification" },
        { "value": "none", "label": "No nursing qualification yet" }
      ]
    },
    {
      "id": "experience_years",
      "prompt": "How many years of nursing work experience do you have?",
      "affects": ["band", "gaps", "risk_notes", "timeline_range"],
      "options": [
        { "value": "0_1", "label": "Less than 1 year" },
        { "value": "1_3", "label": "1–3 years" },
        { "value": "3_5", "label": "3–5 years" },
        { "value": "5_plus", "label": "More than 5 years" }
      ]
    },
    {
      "id": "german_level",
      "prompt": "What is your current German level?",
      "affects": ["band", "gaps", "risk_notes", "timeline_range", "next_step"],
      "options": [
        { "value": "A0", "label": "A0 — no German yet" },
        { "value": "A1", "label": "A1" },
        { "value": "A2", "label": "A2" },
        { "value": "B1", "label": "B1" },
        { "value": "B2", "label": "B2 or higher" }
      ]
    },
    {
      "id": "financial_readiness",
      "prompt": "How ready is your funding for language training and recognition costs?",
      "affects": ["band", "gaps", "risk_notes", "next_step"],
      "options": [
        { "value": "funded", "label": "Fully planned / funded" },
        { "value": "partial", "label": "Partially ready" },
        { "value": "not_ready", "label": "Not ready yet" }
      ]
    },
    {
      "id": "timeline_preference",
      "prompt": "When do you want to move if eligible?",
      "affects": ["band", "gaps", "timeline_range", "risk_notes"],
      "options": [
        { "value": "within_12_months", "label": "Within 12 months" },
        { "value": "12_24_months", "label": "12–24 months" },
        { "value": "unsure", "label": "Not sure yet" }
      ]
    },
    {
      "id": "city_state",
      "prompt": "Where are you based in India?",
      "affects": ["gaps", "risk_notes", "next_step"],
      "options": [
        { "value": "kerala", "label": "Kerala" },
        { "value": "tamil_nadu", "label": "Tamil Nadu" },
        { "value": "karnataka", "label": "Karnataka" },
        { "value": "telangana_ap", "label": "Telangana / Andhra Pradesh" },
        { "value": "other", "label": "Other state / city" }
      ]
    },
    {
      "id": "registration_status",
      "prompt": "Do you have a valid nursing council registration?",
      "affects": ["band", "gaps", "risk_notes"],
      "options": [
        { "value": "active", "label": "Yes — active registration" },
        { "value": "expired", "label": "Expired / needs renewal" },
        { "value": "none", "label": "No registration" }
      ]
    }
  ]
}
